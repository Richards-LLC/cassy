# Build artifacts
/target/
/dist/
.cas.log

# IDE
.idea/
.vscode/
*.swp
*.swo

# macOS
.DS_Store

# Local data
/.mem/
.cas/
.fallow/
/temp/
/index/

# Per-developer ephemeral docs (regenerated by /codemap; working-tree-dependent)
/.claude/CODEMAP.md

# Environment files (contain secrets)
.env
.env.local
.env.worktree

# Node modules
node_modules/

# Build toolchains
.zig-cache/
.context/

# Process sockets
.overmind.sock
# Worktree-specific files (generated per worktree)
# fallow incremental analysis cache (used by the fallow skill)

# Synced project skills — rendered by `cas update --sync`. The builtins and
# database projections are the source of truth; tracking any project skill
# copy dirties the tree on every upstream skill change.
/.claude/skills/*
/.codex/skills/

# Codex/agent rollout session logs — debugging artifacts, not source
docs/requests/**/*.codex-rollout*.jsonl
docs/requests/artifacts/

# Python bytecode — regenerated on every run of the docs/analysis scripts
__pycache__/
*.pyc

# insta pending snapshots — a rejected/unreviewed snapshot is a local review
# artifact, never source. One was committed by an over-broad `git add -A`
# (cas-2c05); ignoring the pattern stops the next worker repeating it.
*.snap.new
