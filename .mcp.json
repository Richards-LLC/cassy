{
  "mcpServers": {
    "cas": {
      "args": [
        "serve"
      ],
      "command": "cas"
    },
    "context7": {
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "github": {
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}"
      },
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "--prefix",
        "hub-web",
        "--no-install",
        "playwright",
        "mcp",
        "--isolated",
        "--headless",
        "--browser",
        "chromium",
        "--output-dir",
        "target/artifacts/playwright-mcp"
      ]
    }
  }
}
