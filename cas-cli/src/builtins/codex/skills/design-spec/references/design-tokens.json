{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Petrastella design language tokens. Source of truth: petrastella-design-language.md beside this file. Projects copy these into their own token file and override in DESIGN.md; a neutral palette is a documented fallback, never the default.",
  "$version": "1.0.0",
  "color": {
    "light": {
      "bg": {
        "$type": "color",
        "$value": "#F7F4EE",
        "$description": "Warm stone paper. Page background."
      },
      "surface": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Cards, ledgers, figure panels."
      },
      "surface-hero": {
        "$type": "color",
        "$value": "#F1E7DD",
        "$description": "Petra sandstone tint. Verdict hero and pull-quote surfaces only."
      },
      "line": {
        "$type": "color",
        "$value": "#DAD3C7",
        "$description": "Hairlines, ledger rules, axes."
      },
      "line-strong": {
        "$type": "color",
        "$value": "#8F8371",
        "$description": "Verdict rule, table sum rule."
      },
      "ink": {
        "$type": "color",
        "$value": "#1B1D24",
        "$description": "Body and display text."
      },
      "ink-muted": {
        "$type": "color",
        "$value": "#5A5F6E",
        "$description": "Captions, provenance, marginal notes, axis labels."
      },
      "verdict": {
        "$type": "color",
        "$value": "#2E3A9F",
        "$description": "Stella indigo. The decisive mark in the hero figure and the verdict rule. Never a status."
      },
      "verdict-soft": {
        "$type": "color",
        "$value": "#DDE1F7",
        "$description": "Band behind the decisive interval or row."
      },
      "evidence": {
        "$type": "color",
        "$value": "#5A5F6E",
        "$description": "Same value as ink-muted, on purpose: evidence is quiet."
      },
      "action": {
        "$type": "color",
        "$value": "#2E3A9F",
        "$description": "Links, buttons, focus ring. Shares the verdict hue: one accent, two jobs, never in the same figure as a status."
      },
      "good": {
        "$type": "color",
        "$value": "#226845"
      },
      "warning": {
        "$type": "color",
        "$value": "#7F5504"
      },
      "danger": {
        "$type": "color",
        "$value": "#B3261E"
      },
      "good-tint": {
        "$type": "color",
        "$value": "rgba(34,104,69,0.10)"
      },
      "warning-tint": {
        "$type": "color",
        "$value": "rgba(127,85,4,0.10)"
      },
      "danger-tint": {
        "$type": "color",
        "$value": "rgba(179,38,30,0.10)"
      },
      "focus": {
        "$type": "color",
        "$value": "#2E3A9F"
      }
    },
    "dark": {
      "bg": {
        "$type": "color",
        "$value": "#12141A"
      },
      "surface": {
        "$type": "color",
        "$value": "#191C24"
      },
      "surface-hero": {
        "$type": "color",
        "$value": "#241E1E",
        "$description": "Sandstone tint at night: rose-brown, not grey."
      },
      "line": {
        "$type": "color",
        "$value": "#2B3040"
