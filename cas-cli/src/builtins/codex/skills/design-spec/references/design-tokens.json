  "typography": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Iowan Old Style",
          "Palatino Linotype",
          "Palatino",
          "Book Antiqua",
          "Georgia",
          "Times New Roman",
          "serif"
        ],
        "$description": "Verdict sentences, page titles, pull-quotes. Regular weight only; italic allowed."
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Inter",
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "JetBrains Mono",
          "IBM Plex Mono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ],
        "$description": "Ledger numbers, timestamps, eyebrows, provenance, code."
      }
    },
    "scale": {
      "$description": "Base 17px, ratio 1.25. Values are px size / line-height / weight / family.",
      "eyebrow": {
        "$type": "typography",
        "$value": {
          "fontSize": "12px",
          "lineHeight": "16px",
          "fontWeight": 600,
          "fontFamily": "mono",
          "letterSpacing": "0.08em",
          "textTransform": "uppercase"
        }
      },
      "caption": {
        "$type": "typography",
        "$value": {
          "fontSize": "14px",
          "lineHeight": "20px",
          "fontWeight": 400,
          "fontFamily": "body"
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontSize": "17px",
          "lineHeight": "26px",
          "fontWeight": 400,
          "fontFamily": "body"
        }
      },
      "lede": {
        "$type": "typography",
        "$value": {
          "fontSize": "21px",
          "lineHeight": "30px",
          "fontWeight": 400,
          "fontFamily": "body"
        }
      },
      "heading": {
        "$type": "typography",
        "$value": {
          "fontSize": "27px",
          "lineHeight": "32px",
          "fontWeight": 600,
          "fontFamily": "body",
          "letterSpacing": "-0.01em"
        }
      },
      "title": {
        "$type": "typography",
        "$value": {
          "fontSize": "34px",
          "lineHeight": "38px",
          "fontWeight": 400,
          "fontFamily": "display"
        }
      },
      "verdict": {
        "$type": "typography",
        "$value": {
          "fontSize": "clamp(32px, 4.6vw, 52px)",
          "lineHeight": 1.08,
          "fontWeight": 400,
          "fontFamily": "display",
          "letterSpacing": "-0.015em",
          "maxWidth": "22ch"
        }
      },
      "hero-number": {
        "$type": "typography",
        "$value": {
          "fontSize": "clamp(56px, 8vw, 96px)",
          "lineHeight": 1,
          "fontWeight": 500,
          "fontFamily": "mono",
          "fontVariantNumeric": "tabular-nums",
          "letterSpacing": "-0.03em"
        }
      },
      "ledger": {
        "$type": "typography",
        "$value": {
          "fontSize": "15px",
          "lineHeight": "22px",
          "fontWeight": 400,
          "fontFamily": "mono",
          "fontVariantNumeric": "tabular-nums"
        }
      }
    },
    "measure": {
      "$type": "dimension",
      "$value": "68ch",
      "$description": "Maximum body line length."
    }
  },
  "space": {
    "$description": "4px base. Sections breathe at 48 and 64; the hero at 96.",
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "8": {
      "$type": "dimension",
      "$value": "32px"
    },
    "12": {
      "$type": "dimension",
      "$value": "48px"
    },
    "16": {
      "$type": "dimension",
      "$value": "64px"
    },
    "24": {
      "$type": "dimension",
      "$value": "96px"
    }
  },
  "layout": {
    "container": {
      "$type": "dimension",
      "$value": "1120px"
    },
    "gutter": {
      "$type": "dimension",
      "$value": "24px"
    },
    "margin-column": {
      "$type": "dimension",
      "$value": "240px",
      "$description": "Marginal-note rail, present at and above the wide breakpoint."
    },
    "breakpoint": {
      "phone": {
        "$type": "dimension",
        "$value": "480px"
      },
      "tablet": {
        "$type": "dimension",
        "$value": "820px"
      },
      "wide": {
        "$type": "dimension",
        "$value": "1080px",
        "$description": "Marginal notes move into the rail; below this they render inline under their anchor."
      }
    }
  },
  "radius": {
    "chip": {
      "$type": "dimension",
      "$value": "4px"
    },
    "panel": {
      "$type": "dimension",
      "$value": "8px"
    },
    "ledger": {
      "$type": "dimension",
      "$value": "0px",
      "$description": "Ledgers and tables are ruled, never boxed."
    }
  },
  "elevation": {
    "paper": {
      "$type": "shadow",
      "$value": "none",
      "$description": "Nothing on the page floats. Hierarchy is type, rule weight, and surface tint."
    },
    "overlay": {
      "$type": "shadow",
      "$value": "0 24px 80px rgba(18,20,26,0.40)",
      "$description": "Dialogs and toasts only."
    }
  },
  "motion": {
    "chrome": {
      "$type": "duration",
      "$value": "120ms",
      "$description": "Hover, focus, toggle. ease-out."
    },
    "reveal": {
      "$type": "duration",
      "$value": "200ms",
      "$description": "Panel and details open. ease-out. Nothing longer."
    },
    "easing": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    },
    "reduced": {
      "$type": "string",
      "$value": "prefers-reduced-motion: reduce disables every transition; no animation may carry information."
    }
  },
  "chart": {
    "stroke": {
      "$type": "dimension",
      "$value": "1.5px",
      "$description": "Lines and slope segments."
    },
    "hairline": {
      "$type": "dimension",
      "$value": "1px",
      "$description": "Axes, gridlines, ledger rules; color = line."
    },
    "mark-decisive": {
      "$type": "dimension",
      "$value": "2.5px",
      "$description": "The one mark that carries the argument; color = verdict."
    },
    "encodings": {
      "actual": {
        "$type": "string",
        "$value": "solid fill"
      },
      "plan": {
        "$type": "string",
        "$value": "1.5px outline, no fill"
      },
      "forecast": {
        "$type": "string",
        "$value": "45deg hatch, 4px pitch"
      },
      "estimate": {
        "$type": "string",
        "$value": "dashed stroke 4 3 plus an interval band at 18% alpha"
      },
      "missing": {
        "$type": "string",
        "$value": "gap in the line and a hollow marker labelled n/a"
      }
    }
  },
  "components": {
    "verdict-hero": {
      "$description": "Eyebrow (mono) → verdict sentence (display, ≤ 22 words) → decisive figure beside it on wide, below it on narrow → 3px verdict rule → one-line provenance (mono, ink-muted). Surface: surface-hero. Nothing else above the fold."
    },
    "evidence-ledger": {
      "$description": "A table styled as a ledger: caption above in body type; header row mono eyebrow; hairline rules only; numbers mono tabular right-aligned; sum row bold above a line-strong rule; last column names the source of each row. No zebra, no box, no rounded corners."
    },
    "annotated-timeline": {
      "$description": "Vertical spine (line-strong) with mono timestamps on the left, events on the right, the decisive event marked in verdict with its annotation drawn as a marginal note connected by a hairline. Elapsed time between events is printed, not inferred."
    }
  },
  "container": {
    "$description": "Rules for any box that holds text. They exist because the recurring defects on our surfaces are white-on-white text, borders cutting through content, and clipped overflow.",
    "text-box-height": {
      "$type": "string",
      "$value": "never a fixed height; use min-height. A fixed height is allowed only with an explicit overflow strategy declared on the same rule: overflow:auto (scroll inside), text-overflow:ellipsis with a title attribute, or line-clamp with a visible affordance."
    },
    "overflow-default": {
      "$type": "string",
      "$value": "overflow:visible for prose and figures; overflow-x:auto for tables and ledgers wider than their column; overflow:hidden only on a purely decorative surface that contains no text."
    },
    "foreground-inherits": {
      "$type": "string",
      "$value": "a surface that changes background must set color on the same rule. Setting bg without fg is how ink-on-ink and white-on-white happen."
    },
    "phone-wrap": {
      "$type": "string",
      "$value": "every text node must wrap or scroll inside its container at 390px; no horizontal page scroll. Mono figures may use white-space:nowrap only inside a scroll container."
    },
    "border-clearance": {
      "$type": "string",
      "$value": "padding inside a bordered box is at least space.3 (12px) on every side; a border may never cross a glyph or a chart mark."
    }
  }
}
