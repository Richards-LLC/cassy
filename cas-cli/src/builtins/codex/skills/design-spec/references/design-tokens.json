    "series": {
      "$description": "Fixed categorical order for color-by-series. A series keeps its slot across every figure in a document. Slot 2 (rose) is skipped in any figure that also carries a danger status. Validate any subset with cas-dataviz validate_palette.js against the surface in use.",
      "light": {
        "$type": "color",
        "$value": [
          "#2E3A9F",
          "#B0574F",
          "#1F7A85",
          "#7A4A9C",
          "#6B7A2A",
          "#6B7280"
        ]
      },
      "dark": {
        "$type": "color",
        "$value": [
          "#A9B3FF",
          "#F2A49C",
          "#6FD0DC",
          "#C9A6EE",
          "#B9CB6A",
          "#9AA1AF"
        ]
      }
    },
    "magnitude": {
      "$description": "Single-hue ramp for quantity. Light surfaces darken; dark surfaces lighten.",
      "light": {
        "$type": "color",
        "$value": [
          "#E5E8F8",
          "#B7BEEB",
          "#8590DA",
          "#5563C2",
          "#2E3A9F"
        ]
