{
  "clarification_id": "spec-b489/v1-receipt-identity-r1",
  "wire_schema": "cassy.binding-reconciliation/v1",
  "status": "Approved design examples; not deployed POST behavior or product-test evidence",
  "scope": "Invocation-bearing reconcile POST only; registered activation GET global-latest semantics and pre-fence nullable rules unchanged",
  "invariants": [
    "For nonnull activation_id, latest_attempt.id equals it even if another attempt commits concurrently; fetch immutable attempt by ID, never global latest",
    "settled maps latest_attempt.settled; original fence settlement is historical",
    "completed reason follows invocation outcome; activated additionally ties fence_receipt.id to activation_id",
    "Every new ordinary invocation has attested_v1_consumers=[]; original ordinary receipt may have []; preserve original admin receipt including nonempty attestations",
    "Existing wire key set and immutable fence authority unchanged; prior prose reference to 15 fields was a counting error, exact pinned set has 14"
  ],
