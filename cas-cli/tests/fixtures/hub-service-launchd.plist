<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.cas.commander-hub</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/cas/bin/cas</string>
    <string>hub</string>
    <string>serve</string>
    <string>--bind</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>4173</string>
    <string>--tailscale-serve</string>
    <string>--tailscale-serve-port</string>
    <string>8443</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/test/.cas/hub/hub.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/test/.cas/hub/hub.log</string>
</dict>
</plist>
