[Unit]
Description=Cassy Commander hub
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/cas/bin/cas hub serve --bind 127.0.0.1 --port 4173 --tailscale-serve --tailscale-serve-port 8443
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
