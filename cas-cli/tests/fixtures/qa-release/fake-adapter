#!/bin/sh
# Fake project QA adapter for qa_release tests (protocol v1). It runs through
# the real qa_command sandbox: only allow-listed variables reach it.
# FAKE_CALL_LOG records each call; FAKE_MIGRATIONS is the `migrations` data.
set -eu
[ -z "${FAKE_PRIVATE:-}" ] || exit 1
[ "$#" -eq 1 ] || exit 1
verb=$1
case "$verb" in served|migrations) ;; *) exit 1 ;; esac
request=$(cat)
[ -z "${FAKE_CALL_LOG:-}" ] || printf '%s\n' "$request" >>"$FAKE_CALL_LOG"
case "$request" in *'"v":1'*) ;; *) exit 1 ;; esac
case "$request" in *"\"verb\":\"$verb\""*) ;; *) exit 1 ;; esac
case "$request" in *'"env":"staging"'*) ;; *) exit 1 ;; esac
if [ -n "${FAKE_ERROR_KIND:-}" ]; then
  printf '{"v":1,"ok":false,"error":{"kind":"%s","provider":"fake-health","status":429,"retry_after_s":30,"message":"slow down"}}\n' "$FAKE_ERROR_KIND"
  exit 0
fi
if [ "$verb" = migrations ]; then
  printf '{"v":1,"ok":true,"data":%s}\n' "$FAKE_MIGRATIONS"
  exit 0
fi
printf '{"v":1,"ok":true,"data":[{"component":"backend","sha":"%s","deploy_ref":"fake-deploy"}]}\n' "$FAKE_SERVED_SHA"
