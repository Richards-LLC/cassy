#!/bin/sh
# Fake project QA adapter for qa_release tests (protocol v1). It runs through
# the real qa_command sandbox: only allow-listed variables reach it.
#   served:     echoes FAKE_SERVED_SHA as the backend component.
#   readback:   answers FAKE_READBACK_DATA, the {invariant: {ok, observed}} map.
#   migrations: answers FAKE_MIGRATIONS, the {id: applied|pending|unknown} map.
#   flags:      answers FAKE_FLAGS_STAGING or FAKE_FLAGS_PROD, the {flag: value}
#               map of the request's env (flags and balance also accept prod).
#   balance:    answers FAKE_BALANCE, the {resource: amount} map.
#   grant:      answers FAKE_GRANT, the {resource: new balance} map.
#   run:        writes one frame into args.media_dir and answers pass, or fail
#               for a journey named in FAKE_RUN_FAIL; FAKE_RUN_ERROR_KIND answers
#               run alone with that classified error.
# FAKE_CALL_LOG records each request; FAKE_SLEEP delays the answer;
# FAKE_ERROR_KIND answers any verb with that classified error instead, with
# retry_after_s FAKE_RETRY_AFTER (default 30).
set -eu
[ -z "${FAKE_PRIVATE:-}" ] || exit 1
[ "$#" -eq 1 ] || exit 1
request=$(cat)
[ -z "${FAKE_CALL_LOG:-}" ] || printf '%s\n' "$request" >>"$FAKE_CALL_LOG"
case "$request" in *'"v":1'*) ;; *) exit 1 ;; esac
case "$request" in *"\"verb\":\"$1\""*) ;; *) exit 1 ;; esac
case "$1:$request" in *'"env":"staging"'*) env=staging ;; flags:*'"env":"prod"'* | balance:*'"env":"prod"'*) env=prod ;; *) exit 1 ;; esac
[ -z "${FAKE_SLEEP:-}" ] || sleep "$FAKE_SLEEP"
if [ -n "${FAKE_ERROR_KIND:-}" ]; then
  printf '{"v":1,"ok":false,"error":{"kind":"%s","provider":"fake-health","status":429,"retry_after_s":%s,"message":"slow down"}}\n' "$FAKE_ERROR_KIND" "${FAKE_RETRY_AFTER:-30}"
  exit 0
fi
case "$1" in
  served)
    printf '{"v":1,"ok":true,"data":[{"component":"backend","sha":"%s","deploy_ref":"fake-deploy"}]}\n' "$FAKE_SERVED_SHA" ;;
  readback)
    case "$request" in *'"journey":"signup"'*) ;; *) exit 1 ;; esac
    printf '{"v":1,"ok":true,"data":%s}\n' "$FAKE_READBACK_DATA" ;;
  migrations)
    printf '{"v":1,"ok":true,"data":%s}\n' "$FAKE_MIGRATIONS" ;;
  flags)
    if [ "$env" = prod ]; then data=$FAKE_FLAGS_PROD; else data=$FAKE_FLAGS_STAGING; fi
    printf '{"v":1,"ok":true,"data":%s}\n' "$data" ;;
  balance)
    printf '{"v":1,"ok":true,"data":%s}\n' "$FAKE_BALANCE" ;;
  grant)
    printf '{"v":1,"ok":true,"data":%s}\n' "$FAKE_GRANT" ;;
  run)
    if [ -n "${FAKE_RUN_ERROR_KIND:-}" ]; then
      printf '{"v":1,"ok":false,"error":{"kind":"%s","provider":"fake-api","status":429,"message":"slow down"}}\n' "$FAKE_RUN_ERROR_KIND"
      exit 0
    fi
    field() { printf '%s' "$request" | sed -n "s/.*\"$1\":\"\([^\"]*\)\".*/\1/p"; }
    journey=$(field journey); row=$(field row); media=$(field media_dir)
    [ -n "$row" ] && [ -d "$media" ] || exit 1
    printf 'frame of %s' "$journey" >"$media/frame.txt"
    status=pass
    case " ${FAKE_RUN_FAIL:-} " in *" $journey "*) status=fail ;; esac
    printf '{"v":1,"ok":true,"data":{"status":"%s","reason":"fake failure","frames":["media/%s/frame.txt"]}}\n' "$status" "$row" ;;
  *) exit 1 ;;
esac
