{
  "name": "@cas/commander-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm run tokens && vite build",
    "test": "node scripts/generate-tokens.mjs --check && npm run tokens && node scripts/run-verified-tests.mjs vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "tokens": "node scripts/generate-tokens.mjs",
    "visual-qa": "npm exec --yes --package=playwright -- node scripts/visual-qa.mjs",
    "check:journey-clock": "node --test scripts/check-journey-clock.test.mjs && node scripts/check-journey-clock.mjs",
    "check:journey-receipts": "node --test e2e/journeys/receipt-directory.test.mjs",
    "prejourneys": "npm run check:journey-clock && npm run check:journey-receipts",
    "journeys": "node scripts/run-verified-tests.mjs playwright --project=journeys",
    "prejourneys:real-hub": "npm run check:journey-clock && npm run check:journey-receipts",
    "journeys:real-hub": "node scripts/run-verified-tests.mjs playwright --config playwright.real-hub.config.ts"
  },
  "devDependencies": {
    "@actions/glob": "0.5.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.2.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  }
}
