{
  "name": "@cas/commander-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm run tokens && vite build",
    "test": "node scripts/generate-tokens.mjs --check && npm run tokens && vitest run",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/generate-tokens.mjs",
    "visual-qa": "npm exec --yes --package=playwright -- node scripts/visual-qa.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  }
}
