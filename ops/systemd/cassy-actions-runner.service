[Unit]
Description=Cassy trusted-branch GitHub Actions runner
Documentation=https://github.com/Richards-LLC/cassy/blob/main/docs/ci/self-hosted-runner-pilot.md
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/cassy-actions/cache

[Service]
Type=simple
User=cassy-actions
Group=cassy-actions
WorkingDirectory=/var/lib/cassy-actions/runner
ExecStartPre=/var/lib/cassy-actions/check-cache-mount.sh
ExecStart=/usr/bin/ionice -c 2 -n 7 /var/lib/cassy-actions/run-service.sh
Restart=always
RestartSec=10s
TimeoutStopSec=2min
KillMode=mixed

# Keep the pilot below the five-worker fleet's scheduling priority and prevent
# one archive compile from treating all 32 logical CPUs as exclusively its own.
Nice=10
CPUWeight=25
IOWeight=25
# A 12-way cold Rust compile uses the sccache server plus enough rustc/linker
# threads to exhaust the distro's 512-task default. Keep the CPU cap below,
# but leave four times that many cgroup task slots so sccache can spawn rustc
# during the archive's parallel fan-out (cas-aada).
TasksMax=2048
Environment=HOME=/var/lib/cassy-actions
Environment=CARGO_HOME=/var/lib/cassy-actions/.cargo
Environment=RUSTUP_HOME=/var/lib/cassy-actions/.rustup
Environment=CARGO_TARGET_DIR=/var/lib/cassy-actions/cache/cargo-target
Environment=SCCACHE_DIR=/var/lib/cassy-actions/cache/sccache
Environment=CARGO_INCREMENTAL=0
Environment=CASSY_ACTIONS_RUNNER_SLOT=1
Environment=CASSY_ACTIONS_TARGET_BUDGET_BYTES=50000000000
Environment=CASSY_ACTIONS_CACHE_MAX_AGE_DAYS=7
Environment=ACTIONS_RUNNER_HOOK_JOB_STARTED=/var/lib/cassy-actions/prune-cache.sh
Environment=ACTIONS_RUNNER_HOOK_JOB_COMPLETED=/var/lib/cassy-actions/prune-cache.sh
# sccache otherwise discovers the operator's machine-global server on its
# default port and crosses Unix-user/cache boundaries. A dedicated port keeps
# runner traffic and statistics inside this service account.
Environment=SCCACHE_SERVER_PORT=4227
Environment=SCCACHE_CACHE_SIZE=8G
# Keep the private server alive across idle merge-queue periods.
Environment=SCCACHE_IDLE_TIMEOUT=0
# Cargo otherwise persists a failed sccache rustc probe in
# CARGO_TARGET_DIR/.rustc_info.json and replays it in later jobs without
# contacting the now-healthy server. The saved target artifacts remain shared;
# this only repeats Cargo's inexpensive rustc version probe per invocation.
Environment=CARGO_CACHE_RUSTC_INFO=0
Environment=CARGO_BUILD_JOBS=12
Environment=RUSTC_WRAPPER=sccache
Environment=PATH=/var/lib/cassy-actions/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# The listener needs network access and one writable state root. It does not
# need root, Docker, factory worktrees, home directories, devices, or kernel
# mutation privileges.
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/cassy-actions

[Install]
WantedBy=multi-user.target
