{
  "Create Release": [
    {
      "file": ".github/workflows/release.yml",
      "job": "release",
      "step": {
        "run_contains": "./scripts/release-publish.sh \"${args[@]}\""
      }
    }
  ],
  "Dispatch install path proof": [
    {
      "file": ".github/workflows/release.yml",
      "job": "release",
      "step": {
        "run_contains": "--limit 20 \\"
      }
    }
  ],
  "Verify private self-hosted sccache": [
    {
      "file": ".github/workflows/ci.yml",
      "job": "fast-validation-preflight",
      "step": {
        "run_contains": "sccache rustc -vV"
      }
    },
    {
      "file": ".github/workflows/ci.yml",
      "job": "fast-validation-suite-build",
      "step": {
        "run_contains": "sccache rustc -vV"
      }
    },
    {
      "file": ".github/workflows/ci.yml",
      "job": "fast-validation-docs",
      "step": {
        "run_contains": "sccache rustc -vV"
      }
    }
  ],
  "Disable sccache for the self-hosted suite archive": [
    {
      "file": ".github/workflows/ci.yml",
      "job": "fast-validation-suite-build",
      "step": {
        "run_contains": "echo 'RUSTC_WRAPPER=' >> \"$GITHUB_ENV\""
      }
    }
  ],
  "Build full suite archive": [
    {
      "file": ".github/workflows/ci.yml",
      "job": "fast-validation-suite-build",
      "step": {
        "run_contains": "python3 scripts/cas-test-targets.py cas-cli --check"
      }
    }
  ],
  "Markdown lint": [
    {
      "file": ".github/workflows/ci.yml",
      "job": "docs-lint",
      "step": {
        "run_contains": "mapfile -t markdown_files < <("
      }
    }
  ]
}
